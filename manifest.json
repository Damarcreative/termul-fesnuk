{
    "manifest_version": 3,
    "name": "Termul",
    "version": "1.0.0",
    "description": "Termul Fesnuk Label",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://www.facebook.com/*",
        "http://localhost:3000/*"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.facebook.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}